#!/bin/bash

alias c="clear"
alias ls="ls --color"
alias ll='ls -alF'
alias la='ls -Al'
alias l='ls -CF'
alias cours='cd /home/kupi/school/third-year/'
alias gc='function _gc(){ git add . && git commit -m "$*" && git push; }; _gc'
alias nf=neofetch
alias dotfiles="cd ~/.dotfiles"
alias cf="clang-format -i *.c ; clang-format -i *.h ; clang-format -i *.cc ; clang-format -i *.hh ; clang-format -i *.hxx"
alias gcd="gcc -std=c99 -pedantic -Werror -Wall -Wextra -Wvla -fsanitize=address -O0 -g"
alias gdb="gdb -q --tui"
alias maked="make --no-print-directory --no-builtin-rules --no-builtin-variables"
alias dotk='function _dot(){ dot -Tpng "$*" -o tmp.png; kitty icat tmp.png }; _dot'

zshrc() {
  "$EDITOR" "$HOME/.zshrc"
}
